@echo off
rem Builds NileSwanIconEditor.exe on this PC with the C# compiler built into
rem Windows (.NET Framework 4.x, present on every Windows 10 and 11), then
rem starts it. A program built locally is not marked as downloaded from the
rem Internet, so Windows SmartScreen does not warn about it.
rem The program icon is stored at the end of this file (base64) and is
rem extracted to a temporary file with certutil, also built into Windows.
cd /d "%~dp0"
set "CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
if not exist "%CSC%" set "CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe"
if not exist "%CSC%" (
  echo C# compiler not found: .NET Framework 4.x is missing.
  pause
  exit /b 1
)
set "ICO=%TEMP%\NileSwanIconEditor_%RANDOM%.ico"
set "ICOOPT="
certutil -f -decode "%~f0" "%ICO%" >nul 2>&1
if exist "%ICO%" set "ICOOPT=/win32icon:%ICO%"
if exist NileSwanIconEditor.exe del NileSwanIconEditor.exe
echo Building NileSwanIconEditor.exe ...
"%CSC%" /nologo /target:winexe /optimize+ %ICOOPT% /out:NileSwanIconEditor.exe /r:System.Windows.Forms.dll /r:System.Drawing.dll NileSwanIconEditor.cs
set "ERR=%ERRORLEVEL%"
if exist "%ICO%" del "%ICO%"
if not "%ERR%"=="0" (
  echo.
  echo Build FAILED.
  pause
  exit /b 1
)
echo Done. From now on start NileSwanIconEditor.exe directly.
start "" NileSwanIconEditor.exe
exit /b 0

